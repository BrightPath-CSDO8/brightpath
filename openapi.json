{
  "openapi": "3.1.1",
  "info": {
    "title": "LearnLaunch",
    "version": "1.0",
    "contact": {
      "name": "CSDO8"
    },
    "description": "This is the OpenAPI specification for LearnLaunch application."
  },
  "servers": [{ "url": "http://127.0.0.1:5000" }],
  "tags": [
    {
      "name": "Courses",
      "description": "Operations related to courses"
    },
    {
      "name": "Course",
      "description": "Get individual course"
    },
    {
      "name": "Students",
      "description": "Operations related to students"
    },
    {
      "name": "Instructors",
      "description": "Operations related to instructors"
    }
  ],
  "components": {
    "schemas": {
      "Course": {
        "type": "object",
        "properties": {
          "course_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "start_date": {
            "type": "string"
          },
          "end_date": {
            "type": "string"
          },
          "class_capacity": {
            "type": "integer"
          }
        },
        "required": ["course_id", "title"]
      },
      "Student": {
        "type": "object",
        "properties": {
          "student_id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          }
        },
        "required": ["student_id", "name"]
      },
      "Instructor": {
        "type": "object",
        "properties": {
          "instructor_id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          }
        },
        "required": ["instructor_id", "name"]
      }
    }
  },
  "paths": {
    "/api/v1/courses": {
      "get": {
        "description": "Retrieve all courses",
        "parameters": [],
        "tags": ["Courses"],
        "operationId": "getAllCourses",
        "responses": {
          "200": {
            "description": "Retrieve all courses",
            "content": {
              "application/json": {
                "example": {
                  "id": 1,
                  "course_id": "CSR101",
                  "title": "Fundamentals of Python",
                  "description": "Learn Basics of Python",
                  "start_date": "24/01/25",
                  "end_date": "25/02/25",
                  "class_capacity": 20
                },
                "schema": {
                  "type": "object",
                  "properties": {
                    "courses ": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Course"
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Course not found."
          },
          "500": {
            "description": "Server connection error."
          }
        }
      }
    },
    "/api/v1/students": {
      "get": {
        "description": "Retrieve all students",
        "parameters": [],
        "tags": ["Students"],
        "operationId": "getAllStudents",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "students": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Student"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/instructors": {
      "get": {
        "description": "Retrieve all instructors",
        "parameters": [],
        "tags": ["Instructors"],
        "operationId": "getAllInstructors",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "instructors": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Instructor"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/courses/{course_id}": {
      "get": {
        "operationId": "getOneCourse",
        "tags": ["Course"],
        "description": "Retrieve individual course by the Course ID",
        "parameters": [
          {
            "name": "course_id",
            "in": "path",
            "description": "ID of course to return",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Retrieve individual course by the Course Id.",
            "content": {
              "application/json": {
                "example": {
                  "id": 1,
                  "course_id": "CSR101",
                  "title": "Fundamentals of Python",
                  "description": "Learn Basics of Python",
                  "start_date": "24/01/25",
                  "end_date": "25/02/25",
                  "class_capacity": 20
                },
                "schema": {
                  "type": "object",
                  "properties": {
                    "courses ": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Course"
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "No such course."
          },
          "500": {
            "description": "Error fetching course."
          }
        }
      }
    }
  }
}
