{
  "openapi": "3.1.1",
  "info": {
    "title": "LearnLaunch",
    "version": "1.0",
    "contact": {
      "name": "CSDO8"
    },
    "description": "This is the OpenAPI specification for LearnLaunch application."
  },
  "servers": [{ "url": "http://127.0.0.1:5000" }],
  "tags": [
    {
      "name": "Courses",
      "description": "Operations related to courses"
    },
    {
      "name": "Course",
      "description": "Operation related to individual course"
    },
    {
      "name": "Students",
      "description": "Operations related to students"
    },
    {
      "name": "Instructors",
      "description": "Operations related to instructors"
    }
  ],
  "components": {
    "schemas": {
      "ErrorResponse":{
        "type":"object",
        "properties": {
          "error":{
            "type":"string",
            "example":"Bad request."
          },
          "message":{
            "type":"string",
            "example":"course_name field is missing"
          },
          "field":{
            "type":"string",
            "example":"course_id_bus"
          }
        }
      },
      "CourseResponse": {
        "type": "object",
        "properties": {
          "course_id_bus": {
            "type": "string"
          },
          "course_name": {
            "type": "string"
          },
          "course_fee": {
            "type": "number",
            "format": "double"
          },
          "description": {
            "type": "string"
          },
          "schedule": {
            "type": "string"
          },
          "start_date": {
            "type": "string",
            "format": "date"
          },
          "end_date": {
            "type": "string",
            "format": "date"
          },
          "status": {
            "type": "string",
            "enum": ["OPEN", "CLOSED","INACTIVE","PENDING"]
          },
          "capacity": {
            "type": "integer"
          }
        },
        "required": [
          "course_id_bus",
          "course_name",
          "course_fee",
          "description",
          "schedule",
          "start_date",
          "end_date",
          "capacity",
          "status"
        ]
      },
      "CoursePatchRequest": {
        "type": "object",
        "properties": {
          "course_name": {
            "type": "string"
          },
          "course_fee": {
            "type": "number",
            "format": "double"
          },
          "description": {
            "type": "string"
          },
          "schedule": {
            "type": "string"
          },
          "start_date": {
            "type": "string",
            "format": "date"
          },
          "end_date": {
            "type": "string",
            "format": "date"
          },
          "status": {
            "type": "string",
            "enum": ["OPEN", "CLOSED","INACTIVE","PENDING"]
          },
          "capacity": {
            "type": "integer"
          }
        }
      },
      "Student": {
        "type": "object",
        "properties": {
          "student_id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          }
        },
        "required": ["student_id", "name"]
      },
      "Instructor": {
        "type": "object",
        "properties": {
          "instructor_id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          }
        },
        "required": ["instructor_id", "name"]
      }
    }
  },
  "paths": {
    "/api/v1/courses": {
      "get": {
        "description": "Retrieve all courses",
        "parameters": [],
        "tags": ["Courses"],
        "operationId": "getAllCourses",
        "responses": {
          "200": {
            "description": "Retrieve all courses",
            "content": {
              "application/json": {
                "example": {
                  "id": 1,
                  "course_id_bus": "CSR-1010",
                  "course_name": "Fundamentals of Python",
                  "course_fee": "180.80",
                  "description": "Learn Basics of Python",
                  "schedule":"Monday, 9am - 11am",
                  "start_date": "24/01/25",
                  "end_date": "25/02/25",
                  "status": "OPEN",
                  "capacity": 20
                },
                "schema": {
                  "type": "object",
                  "properties": {
                    "courses ": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/CourseResponse"
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Course not found.",
            "content": {
              "application/json":{
                "schema":{
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Server connection error.",
            "content": {
              "application/json":{
                "schema":{
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/students": {
      "get": {
        "description": "Retrieve all students",
        "parameters": [],
        "tags": ["Students"],
        "operationId": "getAllStudents",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "students": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Student"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/instructors": {
      "get": {
        "description": "Retrieve all instructors",
        "parameters": [],
        "tags": ["Instructors"],
        "operationId": "getAllInstructors",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "instructors": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Instructor"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/courses/{course_id_bus}": {
      "get": {
        "operationId": "getOneCourse",
        "tags": ["Course"],
        "description": "Retrieve individual course by the Course ID",
        "parameters": [
          {
            "name": "course_id_bus",
            "in": "path",
            "description": "ID of course to return",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Retrieve individual course by the Course Id.",
            "content": {
              "application/json": {
                 "example": {
                  "id": 1,
                  "course_id_bus": "CSR-1010",
                  "course_name": "Fundamentals of Python",
                  "course_fee": "180.80",
                  "description": "Learn Basics of Python",
                  "schedule":"Monday, 9am - 11am",
                  "start_date": "24/01/25",
                  "end_date": "25/02/25",
                  "status": "OPEN",
                  "capacity": 20
                },
                "schema": {
                  "type": "object",
                  "properties": {
                    "courses ": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/CourseResponse"
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "No such course."
          },
          "500": {
            "description": "Error fetching course."
          }
        }
      },
      "patch": {
        "description": "Update existing course information",
        "tags": ["Course"],
        "operationId": "updateCourse",
        "parameters": [
          {
            "name": "course_id_bus",
            "in": "path",
            "description": "ID of course",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "description": "",
          "required": true,
          "content": {
            "application/json": {
              "example": {
                  "course_id_bus": "CSR-1010",
                  "course_name": "Fundamentals of Python",
                  "course_fee": "180.80",
                  "description": "Learn Basics of Python",
                  "schedule":"Monday, 9am - 11am",
                  "start_date": "24/01/25",
                  "end_date": "25/02/25",
                  "status": "OPEN",
                  "capacity": 20
                },
              "schema": {
                "type": "object",
                "properties": {
                  "course": {
                    "type": "object",
                    "items": {
                      "$ref": "#/components/schemas/CoursePatchRequest"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Course updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CourseResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request.",
             "content": {
              "application/json":{
                "schema":{
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorised request.",
             "content": {
              "application/json":{
                "schema":{
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden request.",
             "content": {
              "application/json":{
                "schema":{
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Resource not found.",
            "content": {
              "application/json":{
                "schema":{
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  }
}
