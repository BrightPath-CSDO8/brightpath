{
  "openapi": "3.1.1",
  "info": {
    "title": "LearnLaunch",
    "version": "1.0",
    "contact": {
      "name": "CSDO8"
    },
    "description": "This is the OpenAPI specification for LearnLaunch application."
  },
  "servers": [{ "url": "http://127.0.0.1:5000" }],
  "tags": [
    {
      "name":"Users",
      "description": "Operations related to user authentication/authorization"
    },
    {
      "name": "Courses",
      "description": "Operations related to courses"
    },
    {
      "name": "Course",
      "description": "Operation related to individual course"
    },
    {
      "name": "Students",
      "description": "Operations related to students"
    },
    {
      "name": "Instructors",
      "description": "Operations related to instructors"
    }
  ],
  "components": {
    "schemas": {
      "ErrorResponse":{
        "type":"object",
        "properties": {
          "error":{
            "type":"string",
            "example":"VALIDATION_ERROR"
          },
          "message":{
            "type":"string",
            "example":"Invalid course date"
          },
          "details":{
            "type":"object",
            "additionalProperties": {
              "type":"string"
            },
            "example":{
              "end_date":"End date must be on or after start date."
            }
          }
        },
        "required": ["error", "message"]
      },
      "StudentCreation":{
        "type": "object",
        "properties": {
          "email":{
            "type":"string",
            "example":"jane.tan@example.com"
          },
          "password":{
            "type":"string",
            "example":"password123"
          },
          "first_name": {
            "type": "string",
            "example": "Jane"
          },
          "last_name": {
            "type": "string",
            "example": "Tan"
          },
          "mobile": {
            "type": "string",
            "example":"98765432"
          },
          "dob": {
            "type": "string",
            "format":"date",
            "example":"1990-09-09"
          }
        },
        "required": [
          "email",
          "password",
          "first_name",
          "last_name",
          "mobile",
          "dob"
        ]
      },
      "StudentCreateResponse":{
        "type": "object",
        "properties": {
          "student_id_bus":{
            "type":"string",
            "example":"STU-0909"
          },
          "first_name": {
            "type": "string",
            "example": "Jane"
          },
          "last_name": {
            "type": "string",
            "example": "Tan"
          },
          "mobile": {
            "type": "string",
            "example":"98765432"
          },
          "dob": {
            "type": "string",
            "format":"date",
            "example":"1990-09-09"
          },
          "role":{
            "type":"string",
            "enum": ["STUDENT", "TEACHER","ADMIN","SUPERADMIN"],
            "example":"STUDENT"
          }
        },
        "required": [
          "student_id_bus",
          "first_name",
          "last_name",
          "mobile",
          "dob",
          "role"
        ]
      },
      "StudentLogin":{
        "type":"object",
        "properties": {
          "email":{
            "type":"string",
            "example":"jane.tan@example.com"
          },
          "password":{
            "type":"string",
            "example":"password123"
          }
        }
      },
      "CourseResponse": {
        "type": "object",
        "properties": {
          "course_id_bus": {
            "type": "string",
            "pattern": "^CSR-[0-9]{4}$",
            "example":"CSR-1010"
          },
          "course_name": {
            "type": "string",
            "example": "Introduction to Python"
          },
          "course_fee": {
            "type": "number",
            "format": "float",
            "example": 250.55
          },
          "description": {
            "type": "string",
            "example":"Learn the basics of Python"
          },
          "schedule": {
            "type": "string",
            "example":"Monday 9am - 11am"
          },
          "start_date": {
            "type": "string",
            "format": "date",
            "example":"2026-09-01"
          },
          "end_date": {
            "type": "string",
            "format": "date",
            "example":"2026-12-01"
          },
          "status": {
            "type": "string",
            "enum": ["OPEN", "CLOSED","INACTIVE","PENDING"],
            "example":"PENDING"
          },
          "capacity": {
            "type": "integer",
            "example":30
          },
             "classroom":{
            "type":"string",
            "example": "Roses"
          }
        },
        "required": [
          "course_id_bus",
          "course_name",
          "course_fee",
          "description",
          "schedule",
          "start_date",
          "end_date",
          "capacity",
          "status",
          "classroom"
        ]
      },
      "CourseCreate":{
        "type":"object",
       "properties": {
          "course_name": {
            "type": "string"
          },
          "course_fee": {
            "type": "number",
            "format": "float",
            "example":250.85
          },
          "description": {
            "type": "string"
          },
          "schedule": {
            "type": "string",
            "example":"Monday and Wednesday 9am - 11am"
          },
          "start_date": {
            "type": "string",
            "format": "date",
            "example": "2026-01-20"
          },
          "end_date": {
            "type": "string",
            "format": "date",
            "example": "2026-01-20"
          },
          "capacity": {
            "type": "integer",
            "minimum": 1,
            "example":50 
          }
        },
        "required": [
          "course_name",
          "course_fee",
          "description",
          "schedule",
          "start_date",
          "end_date",
          "capacity"
        ]
      },
      "CoursePatchRequest": {
        "type": "object",
        "properties": {
          "course_name": {
            "type": "string",
            "example":"Introduction to Python 2"
          },
          "course_fee": {
            "type": "number",
            "format": "float",
            "example":250.55
          },
          "description": {
            "type": "string",
            "example": "Advanced topics of Python"
          },
          "schedule": {
            "type": "string"
          },
          "classroom_id":{
            "type":"integer",
            "example": 2
          },
          "start_date": {
            "type": "string",
            "format": "date",
            "example":"2026-09-01"
          },
          "end_date": {
            "type": "string",
            "format": "date",
            "example":"2026-10-01"
          },
          "status": {
            "type": "string",
            "enum": ["OPEN", "CLOSED","INACTIVE","PENDING"]
          },
          "capacity": {
            "type": "integer"
          }
        }
      },
      "Student": {
        "type": "object",
        "properties": {
          "student_id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          }
        },
        "required": ["student_id", "name"]
      },
      "Instructor": {
        "type": "object",
        "properties": {
          "instructor_id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          }
        },
        "required": ["instructor_id", "name"]
      }
    }
  },
  "paths": {
    "/api/v1/courses": {
      "get": {
        "description": "Retrieve all courses",
        "parameters": [],
        "tags": ["Courses"],
        "operationId": "getAllCourses",
        "responses": {
          "200": {
            "description": "Retrieve all courses",
            "content": {
              "application/json": {
                "example": {
                  "course_id_bus": "CSR-1010",
                  "course_name": "Fundamentals of Python",
                  "course_fee": 180.80,
                  "description": "Learn Basics of Python",
                  "schedule":"Monday, 9am - 11am",
                  "classroom":"Roses",
                  "start_date": "2026-09-01",
                  "end_date": "2026-10-01",
                  "status": "OPEN",
                  "capacity": 20
                },
                "schema": {
                  "type": "object",
                  "properties": {
                    "courses ": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/CourseResponse"
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Course not found.",
            "content": {
              "application/json":{
                "schema":{
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Server connection error.",
            "content": {
              "application/json":{
                "schema":{
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "description": "Creates a new course with a system-generated business ID.",
        "operationId": "createCourse",
        "tags": ["Course"],
        "parameters": [],
        "requestBody":{
          "required": true,
          "content": {
            "application/json":{
              "example": {
                  "course_name": "Fundamentals of Python",
                  "course_fee": 180.80,
                  "description": "Learn Basics of Python",
                  "schedule":"Monday, 9am - 11am",
                  "start_date": "2026-09-01",
                  "end_date": "2026-10-01",
                  "capacity": 20
                },
              "schema":{
                "type":"object",
                "properties": {
                  "course":{
                    "type":"object",
                    "items":{
                      "$ref": "#/components/schemas/CourseCreate"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Course created successfully",
            "content": {
              "application/json":{
                "schema": {
                  "$ref": "#/components/schemas/CourseResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request.",
            "content": {
              "application/json":{
                "schema":{
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/courses/{course_id_bus}": {
      "get": {
        "operationId": "getOneCourse",
        "tags": ["Course"],
        "description": "Retrieve individual course by the Course ID",
        "parameters": [
          {
            "name": "course_id_bus",
            "in": "path",
            "description": "ID of course to return",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Retrieve individual course by the Course Id.",
            "content": {
              "application/json": {
                 "example": {
                  "course_id_bus": "CSR-1010",
                  "course_name": "Fundamentals of Python",
                  "course_fee": 180.80,
                  "description": "Learn Basics of Python",
                  "schedule":"Monday, 9am - 11am",
                  "classroom":"Roses",
                  "start_date": "2026-09-01",
                  "end_date": "2026-10-01",
                  "status": "OPEN",
                  "capacity": 20
                },
                "schema": {
                  "type": "object",
                  "properties": {
                    "courses ": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/CourseResponse"
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Course not found.",
            "content": {
              "application/json":{
                "schema":{
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Error fetching course."
          }
        }
      },
      "patch": {
        "description": "Update existing course information",
        "tags": ["Course"],
        "operationId": "updateCourse",
        "parameters": [
          {
            "name": "course_id_bus",
            "in": "path",
            "description": "ID of course",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "description": "",
          "required": true,
          "content": {
            "application/json": {
              "example": {
                  "course_name": "Fundamentals of Python",
                  "course_fee": 180.80,
                  "description": "Learn Basics of Python",
                  "schedule":"Monday, 9am - 11am",
                  "start_date": "2026-09-01",
                  "end_date": "2026-10-01",
                  "status": "OPEN",
                  "capacity": 20
                },
              "schema": {
                "type": "object",
                "properties": {
                  "course": {
                    "type": "object",
                    "items": {
                      "$ref": "#/components/schemas/CoursePatchRequest"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Course updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CourseResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request.",
             "content": {
              "application/json":{
                "schema":{
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorised request.",
             "content": {
              "application/json":{
                "schema":{
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden request.",
             "content": {
              "application/json":{
                "schema":{
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Resource not found.",
            "content": {
              "application/json":{
                "schema":{
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/students": {
      "get": {
        "description": "Retrieve all students",
        "parameters": [],
        "tags": ["Students"],
        "operationId": "getAllStudents",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "students": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Student"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/instructors": {
      "get": {
        "description": "Retrieve all instructors",
        "parameters": [],
        "tags": ["Instructors"],
        "operationId": "getAllInstructors",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "instructors": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Instructor"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/register": {
      "post": {
        "description": "Students creation details",
        "operationId": "createStudent",
        "tags":["Users"],
        "parameters": [],
        "requestBody":{
          "required": true,
          "content": {
            "application/json":{
              "example": {
                  "email": "jane.tan@example.com",
                  "password": "password123",
                  "first_name": "Jane",
                  "last_name":"Tan",
                  "mobile": "98765432",
                  "dob": "1990-10-01"
                },
              "schema":{
                "type":"object",
                "properties": {
                  "student":{
                    "type":"object",
                    "items":{
                      "$ref": "#/components/schemas/StudentCreation"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Student created successfully",
            "content": {
              "application/json":{
                "schema":{
                  "$ref": "#/components/schemas/StudentCreateResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/login": {
      "post": {
        "description": "Student Login",
        "operationId": "studentLogin",
        "tags": ["Users"],
        "parameters": [],
        "requestBody":{
          "required": true,
          "content": {
            "application/json":{
              "example":{
                "email":"jane.tan@example.com",
                "password":"password123"
              },
              "schema":{
                "type":"object",
                "properties": {
                  "student":{
                    "type":"object",
                    "items":{
                      "$ref": "#/components/schemas/StudentLogin"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json":{
                "example":{
                  "message":"Login successfully."
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized.",
            "content": {
              "application/json":{
                "example":{
                  "message":"Email and/or password is incorrect."
                }
              }
            }
          }
        }
      }
    }
    
  }
}
